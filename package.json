{
  "name": "deepseek-harness-desktop",
  "version": "1.0.0",
  "description": "DeepSeek Harness Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "create-icons": "node create-icons.js",
    "build": "node build.js",
    "build:win": "npm run create-icons && electron-packager . DeepSeek-Harness-Desktop --platform=win32 --arch=x64 --out=dist --overwrite",
    "build:mac": "npm run create-icons && electron-packager . DeepSeek-Harness-Desktop --platform=darwin --arch=x64 --out=dist --overwrite",
    "release": "npm run build",
    "version": "npm version patch && git push origin main --tags"
  },
  "keywords": [
    "deepseek",
    "harness",
    "desktop",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  }
}
